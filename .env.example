# Every variable is optional — sensible dev defaults are built in (see packages/shared/src/constants.ts).
# These are LOCAL DEV credentials by design; set real values for anything internet-facing.

# --- server ---
PORT=8080
DATABASE_URL=postgres://iot:iot@localhost:5432/iot
MQTT_URL=mqtt://localhost:1883
MQTT_SERVER_USERNAME=platform-server
MQTT_SERVER_PASSWORD=platform-secret-dev
MQTT_SHARED_GROUP=ingest
PROVISIONING_TOKEN=dev-provisioning-token
INTERNAL_TOKEN=dev-internal-token
WEBHOOK_SECRET=dev-webhook-secret
LOG_LEVEL=info

# --- simulator ---
API_URL=http://localhost:8080
SIM_DEVICE_COUNT=6
SIM_ANOMALY_CHANCE=0.02
SIM_STATE_FILE=./.sim-state.json

# --- infra ---
EMQX_DASHBOARD_PASSWORD=iot-admin-1
GRAFANA_ADMIN_PASSWORD=iot-admin-1
