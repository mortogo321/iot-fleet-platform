{
  "name": "iot-fleet-platform",
  "private": true,
  "version": "1.0.0",
  "description": "IoT fleet management platform POC - MQTT auth delegation, device shadows, RPC, OTA rollout, TimescaleDB telemetry, rules engine, Prometheus/Grafana",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "packageManager": "bun@1.4.4",
  "scripts": {
    "dev:server": "bun run --filter server dev",
    "dev:simulator": "bun run --filter simulator dev",
    "dev:web": "bun run --filter web dev",
    "typecheck": "bun run --filter '*' typecheck",
    "test": "bun test apps packages",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "build:web": "bun run --filter web build"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.2",
    "@types/bun": "^1.4.3",
    "typescript": "^7.0.2"
  }
}
