{
  "uid": "iot-platform",
  "title": "IoT Fleet Platform",
  "schemaVersion": 39,
  "version": 1,
  "style": "dark",
  "timezone": "browser",
  "editable": true,
  "graphTooltip": 0,
  "refresh": "10s",
  "time": { "from": "now-30m", "to": "now" },
  "templating": { "list": [] },
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": { "type": "grafana", "uid": "-- Grafana --" },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Ingest rate",
      "datasource": { "type": "prometheus", "uid": "prom" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "fieldConfig": { "defaults": {}, "overrides": [] },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prom" },
          "expr": "rate(iot_ingest_messages_total[1m])",
          "legendFormat": "{{result}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Batch flush p95",
      "datasource": { "type": "prometheus", "uid": "prom" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "fieldConfig": { "defaults": {}, "overrides": [] },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prom" },
          "expr": "histogram_quantile(0.95, sum(rate(iot_ingest_batch_flush_seconds_bucket[5m])) by (le))",
          "legendFormat": "p95",
          "refId": "A"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Alerts fired",
      "datasource": { "type": "prometheus", "uid": "prom" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "fieldConfig": { "defaults": {}, "overrides": [] },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prom" },
          "expr": "sum(rate(iot_alerts_fired_total[5m])) by (severity)",
          "legendFormat": "{{severity}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Live",
      "datasource": { "type": "prometheus", "uid": "prom" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "fieldConfig": { "defaults": {}, "overrides": [] },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "none"
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prom" },
          "expr": "iot_ws_clients",
          "legendFormat": "WS clients",
          "refId": "A"
        },
        {
          "datasource": { "type": "prometheus", "uid": "prom" },
          "expr": "iot_mqtt_connected",
          "legendFormat": "MQTT connected",
          "refId": "B"
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Device temperature",
      "datasource": { "type": "postgres", "uid": "timescale" },
      "gridPos": { "h": 8, "w": 16, "x": 0, "y": 16 },
      "fieldConfig": { "defaults": {}, "overrides": [] },
      "targets": [
        {
          "datasource": { "type": "postgres", "uid": "timescale" },
          "rawSql": "SELECT time AS \"time\", device_id AS metric, temperature AS value FROM telemetry WHERE $__timeFilter(time) ORDER BY 1",
          "format": "time_series",
          "refId": "A"
        }
      ]
    },
    {
      "id": 6,
      "type": "stat",
      "title": "Devices online",
      "datasource": { "type": "postgres", "uid": "timescale" },
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 16 },
      "fieldConfig": { "defaults": {}, "overrides": [] },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "none"
      },
      "targets": [
        {
          "datasource": { "type": "postgres", "uid": "timescale" },
          "rawSql": "SELECT count(*) FROM devices WHERE status = 'online'",
          "format": "table",
          "refId": "A"
        }
      ]
    }
  ]
}
